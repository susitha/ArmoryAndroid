    <style name="FieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textColorHint">@color/field_border_gray</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="RequiredMarker">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:text">*</item>
        <item name="android:textColor">@color/status_error</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Theme.FetchCICG" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/secondary</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/secondary_button</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:statusBarColor" ns1:targetApi="l">@color/primary</item>
        <item name="android:navigationBarColor" ns1:targetApi="l">@color/primary</item>
    </style>
