<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors ExtendedTextField's styling as set in InputTextFieldView.swift:
     white fill, 10pt corner radius, thin systemGray border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/white" />
    <corners android:radius="10dp" />
    <stroke
        android:width="1dp"
        android:color="@color/field_border_gray" />
</shape>
