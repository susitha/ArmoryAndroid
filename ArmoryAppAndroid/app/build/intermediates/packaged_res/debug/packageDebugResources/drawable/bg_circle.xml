<?xml version="1.0" encoding="utf-8"?>
<!-- Plain circle template — color is set at runtime via
     (drawable as GradientDrawable).setColor(...), see AssetCategoryVisuals.kt.
     Used instead of iOS's handgun/rifle/machinegun icons: those source PDFs
     are white template shapes (same qlmanage-invisible problem as the
     Dashboard menu icons — see SCAFFOLD.md), so a colored circle + category
     initial stands in, which also degrades gracefully for any category name
     instead of iOS's hardcoded 3-case switch. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#34C759" />
</shape>
