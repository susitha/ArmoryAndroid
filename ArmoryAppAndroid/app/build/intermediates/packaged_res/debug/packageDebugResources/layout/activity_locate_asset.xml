<?xml version="1.0" encoding="utf-8"?>
<!-- Kotlin/Android equivalent of LocateAssetViewController.swift: a white
     rounded card (status text/subtitle, a signal-strength gauge + pulsing
     "searching" indicator, battery) on a primary-blue screen, with a
     PrimaryButton (Start/Stop) pinned to the bottom. Same color pattern as
     the rest of this port (see SCAFFOLD.md). -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary"
    android:padding="15dp">

    <TextView
        android:id="@+id/screenTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:text="@string/locate_title"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/assetHeader"
        layout="@layout/view_asset_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screenTitle" />

    <View
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/bg_white_card"
        app:layout_constraintBottom_toTopOf="@id/actionButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/assetHeader" />

    <TextView
        android:id="@+id/stateTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="15dp"
        android:gravity="center"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/cardContainer"
        app:layout_constraintStart_toStartOf="@id/cardContainer"
        app:layout_constraintTop_toTopOf="@id/cardContainer" />

    <TextView
        android:id="@+id/stateSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="15dp"
        android:gravity="center"
        android:textColor="@android:color/darker_gray"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="@id/cardContainer"
        app:layout_constraintStart_toStartOf="@id/cardContainer"
        app:layout_constraintTop_toBottomOf="@id/stateTitle" />

    <!-- Shown when not actively locating (disconnected / low battery / overheated / failed) -->
    <ImageView
        android:id="@+id/statusIcon"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@id/batteryRow"
        app:layout_constraintEnd_toEndOf="@id/cardContainer"
        app:layout_constraintStart_toStartOf="@id/cardContainer"
        app:layout_constraintTop_toBottomOf="@id/stateSubtitle"
        app:layout_constraintVertical_bias="0.5" />

    <!-- Shown while connected/scanning: the signal gauge centered, with the
         device sitting at its base inside the pulsing "searching" rings —
         matches the real iOS screen's layout (a reference screenshot), not
         the earlier side-by-side arrangement. -->
    <FrameLayout
        android:id="@+id/gaugeRow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/batteryRow"
        app:layout_constraintEnd_toEndOf="@id/cardContainer"
        app:layout_constraintStart_toStartOf="@id/cardContainer"
        app:layout_constraintTop_toBottomOf="@id/stateSubtitle">

        <com.cenango.fetchcicg.ui.search.SignalGaugeView
            android:id="@+id/signalGauge"
            android:layout_width="28dp"
            android:layout_height="220dp"
            android:layout_gravity="top|center_horizontal" />

        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="bottom|center_horizontal">

            <com.cenango.fetchcicg.ui.search.PulseView
                android:id="@+id/pulseView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/deviceImage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/device" />
        </FrameLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/batteryRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginBottom="15dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/cardContainer"
        app:layout_constraintStart_toStartOf="@id/cardContainer">

        <TextView
            android:id="@+id/batteryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/actionButton"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:enabled="false"
        android:text="@string/locate_start_button"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_button_background"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
