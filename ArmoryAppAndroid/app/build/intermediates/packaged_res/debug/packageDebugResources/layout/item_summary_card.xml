<?xml version="1.0" encoding="utf-8"?>
<!-- Kotlin/Android equivalent of AssetInfoCardView.swift: title, thin
     separator, detail text, on a white rounded card — confirmed against a
     real screenshot of the sibling Enroll "enter details" screen (same
     source-code pattern). See activity_asset_summary.xml / SCAFFOLD.md. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_white_card"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/cardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/black"
        android:textSize="15sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="6dp"
        android:background="#E0E0E0" />

    <TextView
        android:id="@+id/cardDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@android:color/black"
        android:textSize="15sp" />

</LinearLayout>
