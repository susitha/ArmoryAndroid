<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FetchCICG" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/secondary</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/secondary_button</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:statusBarColor" tools:targetApi="l">@color/primary</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/primary</item>
    </style>

    <!-- Applied only to LoginActivity (the actual launcher activity — there's
         no separate SplashActivity) via androidx.core.splashscreen's
         installSplashScreen(), which backports the Android 12 SplashScreen
         API down to minSdk. White background, postSplashScreenTheme back to
         the app's real theme once the splash is dismissed.

         windowSplashScreenAnimatedIcon points at drawable-nodpi/splash_icon,
         a dedicated 864x864 asset — NOT @mipmap/ic_launcher_foreground.
         The splash icon slot applies the same circular safe-zone masking a
         launcher icon gets (see the launcher-icon notes in SCAFFOLD.md for
         the full math: true safe content width for this logo's aspect ratio
         is ~46%, not the 66% originally assumed), so both assets share that
         same ~46%-width-safe content. But the splash icon renders at a much
         larger on-screen size than a 48dp launcher icon (~240dp per the
         platform's SplashScreen spec), while ic_launcher_foreground's mipmap
         buckets are sized for the 48dp launcher use case (max 192px at
         xxxhdpi) — reusing that asset for the splash meant a ~46%-width
         sliver of an already-small bitmap was being stretched ~5x to fill
         the splash icon's actual display size, which read as visibly low-
         resolution/blurry. splash_icon.png is sized independently (864px
         canvas, single drawable-nodpi asset, same content proportions) so
         the splash gets enough source resolution to look sharp at its real
         display size regardless of density bucket. -->
    <style name="Theme.FetchCICG.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/white</item>
        <item name="postSplashScreenTheme">@style/Theme.FetchCICG</item>
    </style>
</resources>
