<?xml version="1.0" encoding="utf-8"?>
<!-- Shared field styles for the Enroll/Checkin/Checkout forms — mirrors
     InputTextFieldView.swift / InputPickerView.swift: a plain label above a
     white rounded+bordered box (bg_input_field), with a small red required
     marker next to the label when needed. Labels are black because they sit
     on the white card (bg_white_card) confirmed against a real screenshot —
     if a future screen puts this style on a colored surface instead,
     override android:textColor locally rather than changing this default. -->
<resources>

    <style name="FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="RequiredMarker">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:text">*</item>
        <item name="android:textColor">@color/status_error</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="FieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textColorHint">@color/field_border_gray</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>
