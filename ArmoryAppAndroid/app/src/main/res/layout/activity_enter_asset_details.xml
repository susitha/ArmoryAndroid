<?xml version="1.0" encoding="utf-8"?>
<!-- Kotlin/Android equivalent of EnterAssetDetailsViewController.swift: a
     white card of fields (Name*, Description, Serial Number*, Category*,
     User) on a primary-blue screen, with a PrimaryButton pinned to the
     bottom — confirmed against a real screenshot of this exact screen. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary"
    android:padding="15dp">

    <TextView
        android:id="@+id/screenTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:text="@string/enroll_title"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/cardScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_white_card"
        android:clipToOutline="true"
        android:padding="15dp"
        app:layout_constraintBottom_toTopOf="@id/nextButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screenTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Name -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/enroll_name_hint" />

                <TextView style="@style/RequiredMarker" />
            </LinearLayout>

            <EditText
                android:id="@+id/nameInput"
                style="@style/FieldInput"
                android:layout_marginTop="8dp"
                android:inputType="text" />

            <!-- Description -->
            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="16dp"
                android:text="@string/enroll_description_hint" />

            <EditText
                android:id="@+id/descriptionInput"
                style="@style/FieldInput"
                android:layout_marginTop="8dp"
                android:inputType="text" />

            <!-- Serial number -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/enroll_serial_number_hint" />

                <TextView style="@style/RequiredMarker" />
            </LinearLayout>

            <EditText
                android:id="@+id/serialNumberInput"
                style="@style/FieldInput"
                android:layout_marginTop="8dp"
                android:inputType="text" />

            <!-- Category -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/enroll_category_hint" />

                <TextView style="@style/RequiredMarker" />
            </LinearLayout>

            <EditText
                android:id="@+id/categoryInput"
                style="@style/FieldInput"
                android:layout_marginTop="8dp"
                android:drawableEnd="@android:drawable/arrow_down_float"
                android:cursorVisible="false"
                android:focusable="false"
                android:inputType="none" />

            <!-- User (only shown for personal-weapon categories) -->
            <TextView
                android:id="@+id/userLabel"
                style="@style/FieldLabel"
                android:layout_marginTop="16dp"
                android:text="@string/enroll_user_hint"
                android:visibility="gone" />

            <EditText
                android:id="@+id/userInput"
                style="@style/FieldInput"
                android:layout_marginTop="8dp"
                android:drawableEnd="@android:drawable/arrow_down_float"
                android:cursorVisible="false"
                android:focusable="false"
                android:inputType="none"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nextButton"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:enabled="false"
        android:text="@string/scan_next_button"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_button_background"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
