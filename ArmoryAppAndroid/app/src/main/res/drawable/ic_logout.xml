<?xml version="1.0" encoding="utf-8"?>
<!-- Door-bracket + arrow, primary blue, no background badge — matches the
     ported logout.pdf glyph (Assets.xcassets/logout.imageset) that was
     briefly swapped for a plain-arrow-in-circle vector after a screenshot
     that turned out to be misleading; the user confirmed the door+arrow
     shape is the one actually wanted. Drawn as strokes rather than the
     original PNG so it stays crisp at any density without a raster asset. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="44dp"
    android:height="44dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M14,4 L7,4 L7,20 L14,20"
        android:strokeColor="#496BB3"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter"
        android:strokeWidth="1.5" />
    <path
        android:fillColor="#00000000"
        android:pathData="M9,12 L18,12 M13,7 L19,12 L13,17"
        android:strokeColor="#496BB3"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter"
        android:strokeWidth="1.5" />
</vector>
