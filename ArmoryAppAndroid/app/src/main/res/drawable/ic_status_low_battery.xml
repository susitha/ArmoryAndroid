<?xml version="1.0" encoding="utf-8"?>
<!-- Colored circle + white battery pictogram (outline + one low-charge bar).
     Rectangles only — no arcs/curves to get subtly wrong. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FF9500"
        android:pathData="M2,12 A10,10 0 0 1 22,12 A10,10 0 0 1 2,12 Z" />
    <!-- battery nub -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10.5,5 L13.5,5 L13.5,7 L10.5,7 Z" />
    <!-- battery body outline -->
    <path
        android:fillColor="#00000000"
        android:pathData="M8,7 L16,7 L16,20 L8,20 Z"
        android:strokeColor="#FFFFFF"
        android:strokeLineJoin="round"
        android:strokeWidth="1.3" />
    <!-- low charge level -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M9.5,17 L14.5,17 L14.5,19 L9.5,19 Z" />
</vector>
